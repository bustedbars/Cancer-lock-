U(r) = (q1*q2 / (4*pi*epsilon0*r)) * exp(-r/lambda_D)

This assumes a homogeneous medium with vacuum permittivity.
A dielectric medium requires an appropriate permittivity model.

Distances must be strictly positive.
"""

r = np.asarray(distance_m, dtype=np.float64)

if not np.all(np.isfinite(r)):
    raise ValueError("Distances must be finite.")

if np.any(r <= 0):
    raise ValueError("Distances must be greater than zero.")

if not np.isfinite(charge_1_c) or not np.isfinite(charge_2_c):
    raise ValueError("Charges must be finite.")

if not np.isfinite(debye_length_m) or debye_length_m <= 0:
    raise ValueError("Debye length must be finite and positive.")

energy = (
    COULOMB_CONSTANT
    * charge_1_c
    * charge_2_c
    / r
    * np.exp(-r / debye_length_m)
)

if np.ndim(distance_m) == 0:
    return float(energy)

return energy